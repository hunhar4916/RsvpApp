<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RsvpApp.Pages.EventDetailsPage"
             Title="Event Details">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label x:Name="TitleLabel" Style="{StaticResource Heading}" />
            <Label x:Name="DateLabel" FontSize="16" />
            <Label x:Name="TimeLabel" FontSize="16" />
            <Label x:Name="LocationLabel" FontSize="16" />
            <Label x:Name="HostLabel" FontSize="14" TextColor="#616161" />
            <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,6" />
            <Label x:Name="DescriptionLabel" FontSize="16" />

            <Button Text="RSVP" Style="{StaticResource AccentButton}" Margin="0,16,0,0" Clicked="OnRsvpClicked" />
            <Button Text="Who's Coming" Style="{StaticResource PrimaryButton}" Clicked="OnWhosComingClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>