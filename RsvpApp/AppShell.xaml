<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="RsvpApp.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:RsvpApp.Pages"
       Shell.FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{StaticResource Brand}"
       Shell.ForegroundColor="White"
       Shell.TitleColor="White"
       Shell.TabBarBackgroundColor="{StaticResource Brand}"
       Shell.TabBarForegroundColor="White"
       Shell.TabBarTitleColor="White"
       Shell.TabBarUnselectedColor="#C5CAE9">

    <!-- Start page: Login -->
    <ShellContent Route="login"
                  ContentTemplate="{DataTemplate pages:LoginPage}" />

    <!-- After login: tabs at the bottom -->
    <TabBar Route="main">
        <ShellContent Title="Events" Route="events"
                      ContentTemplate="{DataTemplate pages:EventListPage}" />
        <ShellContent Title="My RSVPs" Route="myrsvps"
                      ContentTemplate="{DataTemplate pages:MyRsvpsPage}" />
        <ShellContent Title="Hosting" Route="hosting"
                      ContentTemplate="{DataTemplate pages:HostingPage}" />
    </TabBar>
</Shell>