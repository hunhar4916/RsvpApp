<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RsvpApp.Pages.AttendeeListPage"
             Title="Who's Coming">
    <VerticalStackLayout Padding="24" Spacing="12">
        <Label x:Name="HeaderLabel" Style="{StaticResource Heading}" FontSize="20" />
        <CollectionView x:Name="AttendeesList" EmptyView="No one has RSVP'd yet.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Label Text="{Binding .}" FontSize="16" Padding="0,8" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>