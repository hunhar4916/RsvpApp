<?xml version="1.0" encoding="UTF-8" ?>
<Application x:Class="RsvpApp.App"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RsvpApp.Models">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Colors from the UI Design Document -->
            <Color x:Key="Brand">#3F51B5</Color>
            <Color x:Key="Accent">#FF7043</Color>
            <Color x:Key="PageBg">#FAFAFA</Color>
            <Color x:Key="TextDark">#212121</Color>

            <!-- Page + text defaults -->
            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{StaticResource PageBg}" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextDark}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource TextDark}" />
                <Setter Property="PlaceholderColor" Value="#9E9E9E" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>
            <Style TargetType="Editor">
                <Setter Property="TextColor" Value="{StaticResource TextDark}" />
                <Setter Property="PlaceholderColor" Value="#9E9E9E" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="TextColor" Value="{StaticResource TextDark}" />
            </Style>
            <Style TargetType="TimePicker">
                <Setter Property="TextColor" Value="{StaticResource TextDark}" />
            </Style>

            <!-- Headings: Open Sans bold -->
            <Style x:Key="Heading" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextDark}" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="24" />
            </Style>

            <!-- Buttons -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Brand}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>
            <Style x:Key="AccentButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>
            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Brand}" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
            </Style>

            <!-- One event card, reused by every event list -->
            <DataTemplate x:Key="EventCardTemplate" x:DataType="models:Event">
                <Border Margin="12,6" Padding="14" BackgroundColor="White"
                        Stroke="#E0E0E0" StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="18" />
                        <Label Text="{Binding DateText}" FontSize="14" />
                        <Label Text="{Binding Location}" FontSize="14" TextColor="#616161" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>